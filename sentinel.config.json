{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "ong-agape"
  },
  "guard": {
    "directCommands": {
      "npmScripts": [
        "lint",
        "test",
        "build",
        "check"
      ],
      "npxTools": [
        "eslint",
        "tsc",
        "typescript"
      ],
      "cargoSubcommands": [
        "check",
        "test",
        "clippy",
        "fmt"
      ],
      "tools": [
        "git",
        "python",
        "pip"
      ]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "mixed",
      "config": {
        "includePatterns": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx",
          "**/*.css",
          "**/*.rs",
          "Cargo.toml",
          "Cargo.lock",
          "**/*.py"
        ],
        "excludePatterns": [
          "**/node_modules/**",
          "**/dist/**",
          "**/build/**",
          "**/target/**",
          "**/__pycache__/**",
          "**/.venv/**",
          "**/.git/**",
          "**/glory-rs/**",
          "**/tools/**"
        ],
        "directoryExceptions": [
          "src/handlers",
          "src/repositories",
          "frontend-v2/src/components/ui",
          "frontend-v2/src/features/admin",
          "frontend-v2/src/features/inicio"
        ],
        "portableBoundaries": {
          "dom": [
            "/frontend/src/main.tsx",
            "/frontend-v2/src/main.tsx",
            "/frontend-v2/src/App.tsx",
            "/frontend-v2/src/components/ui/ModalImagen.tsx",
            "/frontend-v2/src/features/donar/ModalAccion.tsx"
          ],
          "window": [
            "/frontend/src/App.tsx",
            "/frontend/src/features/admin/AgapeAdminPanel.tsx",
            "/frontend-v2/src/App.tsx",
            "/frontend-v2/src/components/ui/Confirmar.tsx",
            "/frontend-v2/src/features/admin/ModalEditarMetodo.tsx",
            "/frontend-v2/src/features/admin/PanelAdmin.tsx",
            "/frontend-v2/src/features/admin/VistaAcciones.tsx",
            "/frontend-v2/src/features/admin/VistaAliados.tsx",
            "/frontend-v2/src/features/admin/VistaBlog.tsx",
            "/frontend-v2/src/features/admin/VistaCampanas.tsx",
            "/frontend-v2/src/features/admin/VistaMensajes.tsx",
            "/frontend-v2/src/features/donar/CarruselDonaciones.tsx",
            "/frontend-v2/src/features/donar/Donar.tsx",
            "/frontend-v2/src/features/donar/ModalDatosPago.tsx",
            "/frontend-v2/src/features/inicio/Aliados.tsx"
          ],
          "services": [],
          "loggerModules": [
            "/frontend-v2/src/utils/logger.ts"
          ]
        },
        "rules": {},
        "runtime": {
          "minimumVersion": "",
          "protocolVersion": 0,
          "lockFile": ""
        }
      }
    }
  }
}

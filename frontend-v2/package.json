{
  "name": "ong-agame-frontend-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend nuevo de El Proyecto Ágape, construido desde cero. El frontend/ original queda como referencia.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "images:optimize": "node scripts/optimizar-imagenes.mjs --w 2400 --q 80 --fmt webp",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "vite": "^8.2.2"
  }
}

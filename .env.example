# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Secret para firmar tokens JWT — cambiar en producción
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# Correos que pueden convertirse en owner al registrarse (separados por coma).
# Dejar vacío en producción hasta confirmar la cuenta del cliente.
ADMIN_EMAILS=

# Orígenes permitidos separados por coma. En producción usar solo los dominios reales.
CORS_ALLOWED_ORIGINS=https://elproyectoagape.org

# Proveedores automáticos (opcional; nunca exponer al frontend).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Servidor
HOST=127.0.0.1
PORT=3000

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug
